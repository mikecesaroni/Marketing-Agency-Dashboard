# Netlify headers.
#
# The built files under /assets carry a hash in their name, so a new build
# never reuses a name: they can be cached for a year and never go stale.
# index.html keeps Netlify's default (revalidate on every load), so a new
# deploy is picked up the next time the page opens; the link-preview edge
# function sets no-store on the HTML it rewrites for the client pages.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
