VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# The client-facing site (optional). Clients get token links: a dashboard, a
# weekly report, an ad approval, an onboarding form. Deploy this same build a
# second time with VITE_PUBLIC_ONLY=true (or name its host in VITE_PUBLIC_HOST)
# and that deployment serves ONLY those pages; every other address is a dead
# end, so a client can never reach the CRM by editing a link. The address the
# links go out on is saved in the CRM (Reports, Client dashboards, "Links go
# out on"); VITE_PUBLIC_APP_URL here and the weekly-report function's APP_URL
# secret are only fallbacks. See src/lib/publicSite.js and netlify.toml.
# VITE_PUBLIC_ONLY=true
# VITE_PUBLIC_HOST=clients.example.com
# VITE_PUBLIC_APP_URL=https://clients.example.com
